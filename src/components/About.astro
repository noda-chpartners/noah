---
import { ABOUT } from "../data/content";
import { ABOUT_PAGES } from "../constants/site";
import SectionHead from "./SectionHead.astro";
import GalleryMarquee from "./GalleryMarquee.astro";
---

<section class="section about" id="about">
  <div class="section__inner">
    <SectionHead title="ABOUT" index="01" />

    <div class="about__intro">
      <h3 class="about__quote">{ABOUT.quote}</h3>
      <p class="about__lead">{ABOUT.lead}</p>
      <p class="about__text">{ABOUT.text}</p>
    </div>

    <nav class="about__links" aria-label="ABOUT詳細">
      {
        ABOUT_PAGES.map((page) => (
          <div class="about__item">
            <a class="ed-button" href={page.href}>
              {page.label}
            </a>
            <p class="about__caption">{page.caption}</p>
          </div>
        ))
      }
    </nav>
  </div>

  <GalleryMarquee />
</section>

<style lang="scss">
  .about {
    overflow-x: hidden;

    &__intro {
      max-width: 42em;
      margin-bottom: 48px;

      @include tab {
        margin-bottom: 64px;
      }
    }

    &__quote {
      max-width: 14em;
      margin-bottom: 28px;
      font-size: clamp(1.5rem, 3.4vw, 2.5rem);
      font-weight: 700;
      line-height: 1.55;
      letter-spacing: 0.08em;
    }

    &__lead {
      margin-bottom: 24px;
      color: $c-muted;
      font-size: 0.95rem;
      line-height: 2;
    }

    &__text {
      color: $c-muted;
      font-size: 0.95rem;
      line-height: 2;
      white-space: pre-line;
    }

    &__links {
      display: grid;
      gap: 24px;
      justify-items: center;

      @include tab {
        grid-template-columns: repeat(3, 1fr);
        gap: 24px 20px;
        align-items: start;
      }
    }

    &__item {
      display: grid;
      gap: 12px;
      justify-items: center;
      width: 100%;
    }

    &__caption {
      color: $c-muted;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      line-height: 1.7;
      text-align: center;
    }
  }
</style>
