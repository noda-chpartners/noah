---
import { ABOUT, SECTION } from "../data/content";
import SectionHead from "./SectionHead.astro";
import AboutNav from "./AboutNav.astro";
import GalleryMarquee from "./GalleryMarquee.astro";
---

<section class="section about" id="about">
  <div class="section__inner">
    <SectionHead title={SECTION.about.title} />

    <div class="about__intro">
      <h3 class="about__quote">{ABOUT.quote}</h3>
      <p class="about__lead">{ABOUT.lead}</p>
      <p class="about__text">{ABOUT.text}</p>
    </div>

    <AboutNav />
  </div>

  <GalleryMarquee />
</section>

<style lang="scss">
  .about {
    overflow-x: hidden;

    &__intro {
      max-width: 42em;
      margin-bottom: 48px;

      @include tab {
        margin-bottom: 64px;
      }
    }

    &__quote {
      max-width: 14em;
      margin-bottom: 28px;
      font-size: clamp(1.5rem, 3.4vw, 2.5rem);
      font-weight: 700;
      line-height: 1.55;
      letter-spacing: 0.08em;
    }

    &__lead {
      margin-bottom: 24px;
      color: $c-muted;
      font-size: 0.95rem;
      line-height: 2;
    }

    &__text {
      color: $c-muted;
      font-size: 0.95rem;
      line-height: 2;
      white-space: pre-line;
    }
  }
</style>
