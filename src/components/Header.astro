---
import { Image } from "astro:assets";
import { SITE_INFO, SITE_ASSETS, NAV_ITEMS, resolveNavHref } from "../constants/site";

const pathname = Astro.url.pathname;
---

<header class="header" id="header">
  <div class="header__backdrop" aria-hidden="true"></div>
  <h1 class="header__logo">
    <a class="header__logo_link" href="/">
      <Image
        class="header__logo_image header__logo_image--white image"
        src={SITE_ASSETS.logo.mark}
        alt={`${SITE_INFO.title}ロゴ`}
      />
      <Image
        class="header__logo_image header__logo_image--black image"
        src={SITE_ASSETS.logo.mark}
        alt=""
      />
    </a>
  </h1>

  <button
    class="header__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="global-nav"
    aria-label="メニュー"
  >
    <span class="header__toggle_inner">
      <span class="header__toggle_line header__toggle_line--top"></span>
      <span class="header__toggle_line header__toggle_line--bottom"></span>
    </span>
  </button>

  <nav class="header__nav" id="global-nav">
    <ul class="header__nav_list">
      {
        NAV_ITEMS.map((item) => (
          <li class="header__nav_item">
            <a
              class="header__nav_link link js-shuffle"
              href={resolveNavHref(item.href, pathname)}
              data-shuffle="hover"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById("header");
  const toggle = header?.querySelector<HTMLButtonElement>(".header__toggle");
  const navLinks = header?.querySelectorAll(".header__nav_link");

  const setOpen = (open: boolean) => {
    header?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("is-nav-open", open);
  };

  toggle?.addEventListener("click", () => {
    setOpen(!header?.classList.contains("is-open"));
  });

  navLinks?.forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
</script>

<style lang="scss">
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: auto;
    max-width: 100%;
    padding: 18px 5%;
    color: $c-white;
    background: linear-gradient(
      to bottom,
      rgba($c-base, 0.72) 0%,
      rgba($c-base, 0.28) 55%,
      transparent 100%
    );
    z-index: 999;
    transition: background 0.35s ease;

    @include pc {
      padding: 22px 4%;
    }

    &__backdrop {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: 0;
      background: rgba($c-base, 0.92);
      transition: opacity 0.35s ease;
    }

    &.is-open &__backdrop {
      opacity: 1;
    }

    &.is-open {
      background: transparent;
      border-bottom: 1px solid $c-line-light;
    }

    &__logo {
      width: 52px;
      flex-shrink: 0;
      position: relative;
      z-index: 2;

      @include pc {
        width: 64px;
      }
    }

    &__logo_link {
      display: block;
    }

    &__toggle {
      position: relative;
      z-index: 2;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 44px;
      height: 44px;
      cursor: pointer;

      @include pc {
        display: none;
      }

      &_inner {
        position: relative;
        display: block;
        width: 22px;
        height: 14px;
        margin-inline: auto;
      }

      &_line {
        position: absolute;
        left: 0;
        display: block;
        width: 100%;
        height: 2px;
        background-color: $c-white;
        transition: transform 0.3s ease, top 0.3s ease, bottom 0.3s ease;
      }

      &_line--top {
        top: 0;
      }

      &_line--bottom {
        bottom: 0;
      }
    }

    &.is-open &__toggle_line--top {
      top: 6px;
      transform: rotate(45deg);
    }

    &.is-open &__toggle_line--bottom {
      bottom: 6px;
      transform: rotate(-45deg);
    }

    &__nav {
      @include pc-down {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba($c-base, 0.96);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        z-index: 1;
        transition: opacity 0.35s ease, visibility 0.35s ease;
      }

      @include pc {
        position: static;
      }

      &_list {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 28px;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0.22em;

        @include pc {
          flex-direction: row;
          gap: clamp(16px, 2.4vw, 40px);
          font-size: 0.75rem;
        }
      }

      &_item {
        min-width: 0;
        flex: 0 0 auto;
      }

      &_link {
        display: inline-block;
        white-space: nowrap;
        overflow: hidden;
        text-align: center;
      }
    }

    &.is-open &__nav {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }

  :global(.header__logo_image) {
    display: block;
    width: 100%;
    height: auto;
  }

  :global(.header__logo_image--black) {
    display: none;
  }
</style>
