---
import { ABOUT_PAGES } from "../constants/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<nav class="about-subnav page-block" aria-label="ABOUT関連ページ">
  {
    ABOUT_PAGES.map((page) => (
      <div class="about-subnav__item">
        <a
          class:list={[
            "ed-button",
            { "is-current": pathname === page.href },
          ]}
          href={page.href}
          aria-current={pathname === page.href ? "page" : undefined}
        >
          {page.label}
        </a>
        <p class="about-subnav__caption">{page.caption}</p>
      </div>
    ))
  }
</nav>

<style lang="scss">
  .about-subnav {
    display: grid;
    gap: 24px;
    justify-items: center;
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid $c-line;

    @include tab {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px 20px;
      margin-top: 72px;
      padding-top: 48px;
    }
  }

  .about-subnav__item {
    display: grid;
    gap: 12px;
    justify-items: center;
    width: 100%;
  }

  .about-subnav__caption {
    color: $c-muted;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    line-height: 1.7;
    text-align: center;
  }

  .about-subnav :global(.ed-button.is-current) {
    background-color: $c-base;
    color: $c-white;
    pointer-events: none;
  }
</style>
