---
import { Image } from "astro:assets";
import loadingBg from "../assets/images/loading-bg.png";
---

<div class="loader" id="loader" aria-hidden="true">
  <div class="loader__media">
    <Image class="loader__bg" src={loadingBg} alt="" />
  </div>
  <div class="loader__veil" aria-hidden="true"></div>
  <div class="loader__copy">
    <p class="loader__title">Be Your Sun.</p>
    <p class="loader__lead">照らせ。誰でもない、自分を。</p>
  </div>
</div>

<style lang="scss">
  .loader {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background-color: #f3c48a;
    pointer-events: none;
    visibility: hidden;
    color: $c-base;

    :global(html.is-awaiting-loader) & {
      visibility: visible;
      pointer-events: auto;
    }

    :global(html.is-ready) & {
      visibility: hidden;
      pointer-events: none;
    }

    &__media {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    &__veil {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        to top,
        rgba($c-white, 0.08) 0%,
        rgba($c-white, 0.04) 50%,
        rgba($c-white, 0.06) 100%
      );
    }

    &__copy {
      position: relative;
      z-index: 2;
      display: grid;
      justify-items: center;
      gap: 20px;
      padding: 0 6%;
      text-align: center;
    }

    &__title {
      font-size: clamp(2.2rem, 7.2vw, 5.2rem);
      font-weight: 300;
      letter-spacing: 0.08em;
      line-height: 1.15;
    }

    &__lead {
      font-size: clamp(0.82rem, 1.6vw, 1rem);
      font-weight: 400;
      letter-spacing: 0.22em;
      line-height: 1.8;
    }
  }

  :global(.loader__bg) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }
</style>
