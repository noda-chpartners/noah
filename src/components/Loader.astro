---
import { Image } from "astro:assets";
import { SITE_ASSETS, SITE_INFO } from "../constants/site";
---

<div class="loader" id="loader" aria-hidden="true">
  <p class="loader__label">( Welcome )</p>
  <div class="loader__brand">
    <Image
      class="loader__logo image"
        src={SITE_ASSETS.logo.mark}
      alt={SITE_INFO.title}
    />
  </div>
  <div class="loader__meta">
    <div class="loader__bar" aria-hidden="true">
      <span class="loader__progress"></span>
    </div>
    <p class="loader__count">000</p>
  </div>
</div>

<style lang="scss">
  .loader {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    background-color: $c-base;
    color: $c-white;
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;

    :global(html.is-awaiting-loader) & {
      visibility: visible;
      pointer-events: auto;
    }

    :global(html.is-ready) & {
      visibility: hidden;
      pointer-events: none;
    }

    &__label {
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      color: rgba($c-white, 0.5);
    }

    &__brand {
      width: min(220px, 56vw);
    }

    &__meta {
      display: grid;
      justify-items: center;
      gap: 16px;
      width: min(240px, 70vw);
    }

    &__bar {
      width: 100%;
      height: 1px;
      background-color: rgba($c-white, 0.18);
      overflow: hidden;
    }

    &__progress {
      display: block;
      width: 100%;
      height: 100%;
      background-color: $c-white;
      transform: scaleX(0);
      transform-origin: left center;
    }

    &__count {
      font-size: 0.72rem;
      font-weight: 300;
      letter-spacing: 0.28em;
    }
  }

  :global(.loader__logo) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
