---
import { COMPANY_INFO, LINE_URL } from "../constants/site";
import { SECTION } from "../data/content";
import EdHead from "./EdHead.astro";
---

<section class="section contact" id="contact">
  <div class="contact__panel">
    <div class="section__inner">
      <EdHead
        class="contact__head"
        label={SECTION.contact.label}
        title={SECTION.contact.title}
      />

      <div class="contact__body">
        <p class="contact__note">{SECTION.contact.note}</p>

        <div class="contact__actions">
          <a class="ed-button" href="/contact">
            お問い合わせフォーム
          </a>
          <a
            class="ed-button"
            href={LINE_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            LINE
          </a>
          <a class="ed-textlink" href={`tel:${COMPANY_INFO.telLink}`}>
            {COMPANY_INFO.tel}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .contact {
    padding: 0;
    border-top: none;
    text-align: center;

    &__panel {
      background-color: $c-base;
      color: $c-white;
      padding: 64px 6%;

      @include tab {
        padding: 96px 5%;
      }

      @include pc {
        padding: 112px 4%;
      }
    }

    :global(.contact__head) {
      margin-bottom: 48px;

      @include tab {
        margin-bottom: 64px;
      }
    }

    &__body {
      width: 100%;
      max-width: 720px;
      margin-inline: auto;
    }

    &__note {
      margin-bottom: 40px;
      font-size: clamp(1.05rem, 1.8vw, 1.35rem);
      font-weight: 300;
      letter-spacing: 0.1em;
      line-height: 1.9;
    }

    &__actions {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
    }
  }

  :global(.contact__panel .ed-label) {
    color: rgba($c-white, 0.55);
  }

  :global(.contact__panel .ed-button:hover) {
    background-color: $c-white;
    color: $c-base;
  }
</style>
