---
import { CONTACT_TYPES } from "../data/content";
---

<form class="form" id="contact-form" novalidate>
  <input
    class="form__hp"
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="form__field">
    <label class="form__label ed-label" for="contact-name">( お名前 )</label>
    <input
      class="form__input"
      id="contact-name"
      name="name"
      type="text"
      autocomplete="name"
      required
    />
  </div>

  <div class="form__field">
    <label class="form__label ed-label" for="contact-company">( 会社名 )</label>
    <input
      class="form__input"
      id="contact-company"
      name="company"
      type="text"
      autocomplete="organization"
    />
  </div>

  <div class="form__field">
    <label class="form__label ed-label" for="contact-email">( メールアドレス )</label>
    <input
      class="form__input"
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      required
    />
  </div>

  <div class="form__field">
    <label class="form__label ed-label" for="contact-tel">( 電話番号 )</label>
    <input
      class="form__input"
      id="contact-tel"
      name="tel"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
    />
  </div>

  <div class="form__field">
    <label class="form__label ed-label" for="contact-type">( お問い合わせ種別 )</label>
    <select class="form__input form__select" id="contact-type" name="type" required>
      <option value="" disabled selected>選択してください</option>
      {
        CONTACT_TYPES.map((item) => (
          <option value={item.value}>{item.label}</option>
        ))
      }
    </select>
  </div>

  <div class="form__field">
    <label class="form__label ed-label" for="contact-message">( お問い合わせ内容 )</label>
    <textarea
      class="form__input form__textarea"
      id="contact-message"
      name="message"
      rows="6"
      required
    ></textarea>
  </div>

  <p class="form__error" id="contact-error" role="alert" hidden></p>

  <button class="ed-button form__submit" type="submit">送信する</button>
</form>

<div class="form-done" id="contact-done" hidden>
  <p class="ed-label">( Thank you )</p>
  <h2 class="form-done__title">お問い合わせを受け付けました</h2>
  <p class="form-done__text">
    内容を確認のうえ、担当者よりご連絡いたします。<br />
    お急ぎの場合は、お電話でもご連絡ください。
  </p>
  <a class="ed-textlink" href="/">トップへ戻る</a>
</div>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const done = document.getElementById("contact-done");
  const error = document.getElementById("contact-error");
  const typeField = document.getElementById("contact-type") as HTMLSelectElement | null;

  const type = new URLSearchParams(location.search).get("type");
  const allowed = ["service", "recruit", "other"];
  if (type && allowed.includes(type) && typeField) {
    typeField.value = type;
  }

  const showError = (message: string) => {
    if (!error) return;
    error.hidden = false;
    error.textContent = message;
  };

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form) return;

    const honeypot = form.elements.namedItem("website") as HTMLInputElement | null;
    if (honeypot?.value) {
      form.hidden = true;
      if (done) done.hidden = false;
      return;
    }

    if (!form.checkValidity()) {
      form.reportValidity();
      showError("未入力の項目があります。内容をご確認ください。");
      return;
    }

    if (error) {
      error.hidden = true;
      error.textContent = "";
    }

    form.hidden = true;
    if (done) done.hidden = false;
  });
</script>

<style lang="scss">
  .form {
    display: grid;
    gap: 8px;

    &[hidden] {
      display: none;
    }

    &__hp {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    &__field {
      padding: 22px 0;
      border-bottom: 1px solid $c-line;
    }

    &__label {
      display: block;
      margin-bottom: 12px;
    }

    &__input {
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      background: transparent;
      color: $c-base;
      font-family: inherit;
      font-size: 0.95rem;
      letter-spacing: 0.06em;
      line-height: 1.8;
      outline: none;

      &::placeholder {
        color: $c-muted;
      }
    }

    &__select {
      cursor: pointer;
      appearance: none;
      background-image: linear-gradient($c-base, $c-base);
      background-position: right 8px center;
      background-repeat: no-repeat;
      background-size: 8px 1px;
      padding-right: 24px;
    }

    &__textarea {
      resize: vertical;
      min-height: 8em;
    }

    &__error {
      margin-top: 16px;
      color: $c-base;
      font-size: 0.82rem;
      letter-spacing: 0.06em;
    }

    &__submit {
      margin-top: 40px;
      width: 100%;
      max-width: 320px;
      cursor: pointer;
    }
  }

  .form-done {
    padding-top: 12px;

    &[hidden] {
      display: none;
    }

    &__title {
      margin: 16px 0 20px;
      font-size: clamp(1.3rem, 2.2vw, 1.8rem);
      font-weight: 300;
      letter-spacing: 0.12em;
      line-height: 1.6;
    }

    &__text {
      margin-bottom: 36px;
      color: $c-muted;
      font-size: 0.9rem;
      line-height: 2;
    }
  }
</style>
