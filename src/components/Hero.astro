---
import { Image } from "astro:assets";
import heroImage from "../assets/images/hero.png";
import { ABOUT } from "../data/content";
---

<section class="hero">
  <div class="hero__media">
    <Image class="hero__image image" src={heroImage} alt="" />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content">
    <p class="hero__catch">{ABOUT.vision.subtitle}</p>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    height: 100dvh;
    overflow: hidden;

    &__media {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    &__overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        to top,
        rgba($c-base, 0.55) 0%,
        rgba($c-base, 0.12) 45%,
        rgba($c-base, 0.2) 100%
      );
    }

    &__content {
      position: absolute;
      left: 6%;
      right: 6%;
      bottom: 10%;
      z-index: 2;

      @include pc {
        left: 4%;
        right: 4%;
        bottom: 12%;
      }
    }

    &__catch {
      max-width: 18em;
      color: $c-white;
      font-size: clamp(1.35rem, 3.4vw, 2.4rem);
      font-weight: 700;
      line-height: 1.6;
      letter-spacing: 0.12em;
    }
  }

  :global(.hero__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
