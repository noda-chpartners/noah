---
import { Image } from "astro:assets";
import heroImage from "../assets/images/hero.png";
---

<section class="hero">
  <div class="hero__media">
    <Image class="hero__image image" src={heroImage} alt="" />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content">
    <div class="hero__copy">
      <p class="hero__catch">HEAD OUT.</p>
      <p class="hero__sub">出発しよう。</p>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    height: 100dvh;
    overflow: hidden;

    &__media {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    &__overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        to top,
        rgba($c-base, 0.55) 0%,
        rgba($c-base, 0.12) 45%,
        rgba($c-base, 0.2) 100%
      );
    }

    &__content {
      position: absolute;
      left: 6%;
      right: 6%;
      bottom: 10%;
      z-index: 2;

      @include pc {
        left: 4%;
        right: 4%;
        bottom: 12%;
      }
    }

    &__copy {
      display: inline-flex;
      flex-direction: column;
      align-items: flex-end;
      max-width: 100%;
    }

    &__catch {
      display: block;
      color: $c-white;
      font-size: clamp(2.2rem, 6.4vw, 5.4rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }

    &__sub {
      margin-top: 14px;
      margin-right: 18%;
      color: $c-white;
      font-size: clamp(0.78rem, 1.2vw, 0.92rem);
      font-weight: 400;
      letter-spacing: 0.28em;
      line-height: 1.6;
    }
  }

  :global(.hero__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
