---
import { Image } from "astro:assets";
import { HERO } from "../data/content";
import { HERO_SLIDES } from "../data/media";
import { SITE_INFO } from "../constants/site";
---

<section class="hero">
  <div class="hero__media">
    {
      HERO_SLIDES.map((src, index) => (
        <Image
          class:list={["hero__image", "image", { "is-active": index === 0 }]}
          src={src}
          alt={index === 0 ? `${SITE_INFO.title}のメインビジュアル` : ""}
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : "low"}
          widths={[960, 1440, 1920]}
          sizes="100vw"
        />
      ))
    }
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content">
    <div class="hero__copy">
      <p class="hero__catch">{HERO.catch}</p>
      <p class="hero__sub">{HERO.sub}</p>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    height: 100dvh;
    overflow: hidden;

    &__media {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
    }

    &__overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        to top,
        rgba($c-base, 0.55) 0%,
        rgba($c-base, 0.12) 45%,
        rgba($c-base, 0.2) 100%
      );
    }

    &__content {
      position: absolute;
      left: 6%;
      right: 6%;
      bottom: 10%;
      z-index: 2;

      @include pc {
        left: 4%;
        right: 4%;
        bottom: 12%;
      }
    }

    &__copy {
      display: inline-flex;
      flex-direction: column;
      align-items: flex-end;
      max-width: 100%;
    }

    &__catch {
      display: block;
      color: $c-white;
      font-size: clamp(2.8rem, 8vw, 6.8rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: 0.08em;
      white-space: nowrap;
      opacity: 0;
    }

    &__sub {
      margin-top: 18px;
      margin-right: 18%;
      color: $c-white;
      font-size: clamp(0.98rem, 1.55vw, 1.18rem);
      font-weight: 400;
      letter-spacing: 0.28em;
      line-height: 1.6;
      opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      &__catch,
      &__sub {
        opacity: 1;
      }
    }
  }

  :global(.hero__image) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform-origin: center center;
    backface-visibility: hidden;
    will-change: opacity, transform;
  }

  :global(.hero__image.is-active) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.hero__image) {
      opacity: 0;
    }

    :global(.hero__image.is-active) {
      opacity: 1;
    }
  }
</style>
