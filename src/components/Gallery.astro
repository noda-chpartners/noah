---
import { Image } from "astro:assets";
import { PEOPLE } from "../data/content";
import galleryTeam from "../assets/gallery/gallery03.jpg";
import galleryWork from "../assets/gallery/gallery04.jpg";
import galleryCafe from "../assets/gallery/gallery09.jpg";
import galleryJenga from "../assets/gallery/gallery013.jpg";
import galleryTalk from "../assets/gallery/gallery014.jpg";
import galleryLounge from "../assets/gallery/gallery010.jpg";
import gallerySofa from "../assets/gallery/gallery08.jpg";
import galleryGather from "../assets/gallery/gallery07.jpg";
import galleryPeace from "../assets/gallery/gallery06.jpg";
import galleryChat from "../assets/gallery/gallery011.jpg";
import galleryPortrait from "../assets/gallery/gallery012.jpg";

interface Props {
  asPage?: boolean;
}

const { asPage = false } = Astro.props;
const Heading = asPage ? "h1" : "h2";

const PHOTOS = [
  { src: galleryTeam, alt: "Noahのメンバー", area: "team" },
  { src: galleryWork, alt: "打ち合わせの様子", area: "work" },
  { src: galleryCafe, alt: "カフェスペースでの作業", area: "cafe" },
  { src: galleryJenga, alt: "オフィスでの交流", area: "play" },
  { src: galleryTalk, alt: "1対1の対話", area: "talk" },
  { src: galleryLounge, alt: "ラウンジでの作業", area: "lounge" },
  { src: gallerySofa, alt: "ソファでの会話", area: "sofa" },
  { src: galleryGather, alt: "社内の食事会", area: "gather" },
  { src: galleryPortrait, alt: "メンバーのポートレート", area: "portrait" },
  { src: galleryPeace, alt: "メンバーのひとコマ", area: "peace" },
  { src: galleryChat, alt: "ソファでの歓談", area: "chat" },
];
---

<section class:list={["section", "gallery", { page: asPage }]} id="people">
  <div class="section__inner">
    <header class="ed-head">
      <p class="ed-label">( {PEOPLE.label} )</p>
      <Heading class="ed-title js-shuffle" data-shuffle="view">{PEOPLE.title}</Heading>
    </header>
    <p class="gallery__lead">{PEOPLE.lead}</p>
    {asPage && <p class="gallery__text page-block">{PEOPLE.text}</p>}

    <ul class="gallery__grid">
      {
        PHOTOS.map((photo) => (
          <li class={`gallery__item gallery__item--${photo.area}`}>
            <Image
              class="gallery__image"
              src={photo.src}
              alt={photo.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
            />
          </li>
        ))
      }
    </ul>
    <slot />
  </div>
</section>

<style lang="scss">
  .gallery {
    &:not(.page) {
      border-top: 1px solid $c-line;
    }

    .ed-head {
      margin-bottom: 20px;

      @include tab {
        margin-bottom: 24px;
      }
    }

    &__lead {
      max-width: 20em;
      margin-bottom: 20px;
      font-size: clamp(1.05rem, 1.8vw, 1.25rem);
      font-weight: 300;
      letter-spacing: 0.12em;
      line-height: 1.9;
      color: $c-muted;
    }

    &__text {
      max-width: 36em;
      margin-bottom: 40px;
      font-size: 0.9rem;
      line-height: 2.1;
      color: $c-muted;

      @include tab {
        margin-bottom: 56px;
      }
    }

    &:not(.page) &__lead {
      margin-bottom: 40px;

      @include tab {
        margin-bottom: 56px;
      }
    }

    &__grid {
      display: grid;
      gap: 8px;

      @include tab {
        grid-template-columns: repeat(6, 1fr);
        grid-auto-rows: 150px;
        gap: 10px;
      }

      @include pc {
        grid-auto-rows: 180px;
        gap: 12px;
      }
    }

    &__item {
      overflow: hidden;
      aspect-ratio: 4/3;

      @include tab {
        aspect-ratio: auto;
        min-height: 0;
        height: 100%;
      }

      &--team {
        @include tab {
          grid-column: 1 / 5;
          grid-row: span 2;
        }
      }

      &--work,
      &--cafe {
        @include tab {
          grid-column: 5 / 7;
          grid-row: span 1;
        }
      }

      &--play,
      &--sofa {
        @include tab {
          grid-column: 1 / 4;
          grid-row: span 2;
        }
      }

      &--talk,
      &--lounge {
        @include tab {
          grid-column: 4 / 7;
          grid-row: span 1;
        }
      }

      &--gather {
        @include tab {
          grid-column: 4 / 7;
          grid-row: span 2;
        }
      }

      &--portrait,
      &--peace {
        @include tab {
          grid-column: span 3;
          grid-row: span 2;
        }
      }

      &--chat {
        @include tab {
          grid-column: 1 / 7;
          grid-row: span 2;
        }
      }

      &:hover :global(.gallery__image) {
        transform: scale(1.04);
      }
    }
  }

  :global(.gallery__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
    user-select: none;
    transition: transform 1s ease;
  }
</style>
