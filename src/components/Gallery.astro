---
import { Image } from "astro:assets";
import { PEOPLE } from "../data/content";
import { GALLERY_PHOTOS } from "../data/media";
import EdHead from "./EdHead.astro";
---

<section class="section gallery page" id="people">
  <div class="section__inner">
    <EdHead as="h1" label={PEOPLE.label} title={PEOPLE.title} />
    <p class="gallery__lead">{PEOPLE.lead}</p>
    <p class="gallery__text">{PEOPLE.text}</p>

    <ul class="gallery__grid">
      {
        GALLERY_PHOTOS.map((photo) => (
          <li class={`gallery__item gallery__item--${photo.area}`}>
            <Image
              class="gallery__image"
              src={photo.src}
              alt={photo.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
            />
          </li>
        ))
      }
    </ul>
    <slot />
  </div>
</section>

<style lang="scss">
  .gallery {
    :global(.ed-head) {
      margin-bottom: 16px;

      @include tab {
        margin-bottom: 20px;
      }
    }

    &__lead {
      max-width: 20em;
      margin-bottom: 12px;
      font-size: clamp(1.05rem, 1.8vw, 1.25rem);
      font-weight: 300;
      letter-spacing: 0.12em;
      line-height: 1.9;
      color: $c-muted;
    }

    &__text {
      max-width: 36em;
      margin-bottom: 24px;
      font-size: 0.9rem;
      line-height: 2.1;
      color: $c-muted;

      @include tab {
        margin-bottom: 28px;
      }
    }

    &__grid {
      display: grid;
      gap: 8px;

      @include tab {
        grid-template-columns: repeat(6, 1fr);
        grid-auto-rows: 150px;
        gap: 10px;
      }

      @include pc {
        grid-auto-rows: 180px;
        gap: 12px;
      }
    }

    &__item {
      overflow: hidden;
      aspect-ratio: 4/3;

      @include tab {
        aspect-ratio: auto;
        min-height: 0;
        height: 100%;
      }

      &--team {
        @include tab {
          grid-column: 1 / 5;
          grid-row: span 2;
        }
      }

      &--work,
      &--cafe {
        @include tab {
          grid-column: 5 / 7;
          grid-row: span 1;
        }
      }

      &--play,
      &--sofa {
        @include tab {
          grid-column: 1 / 4;
          grid-row: span 2;
        }
      }

      &--talk,
      &--lounge {
        @include tab {
          grid-column: 4 / 7;
          grid-row: span 1;
        }
      }

      &--gather {
        @include tab {
          grid-column: 4 / 7;
          grid-row: span 2;
        }
      }

      &--portrait,
      &--peace {
        @include tab {
          grid-column: span 3;
          grid-row: span 2;
        }
      }

      &--chat {
        @include tab {
          grid-column: 1 / 7;
          grid-row: span 2;
        }
      }

      &:hover :global(.gallery__image) {
        transform: scale(1.04);
      }
    }
  }

  :global(.gallery__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
    user-select: none;
    transition: transform 1s ease;
  }
</style>
