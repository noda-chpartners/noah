---
import { Image } from "astro:assets";
import { SERVICES } from "../data/content";
---

<section class="section service" id="service">
  <div class="section__inner">
    <header class="ed-head">
      <p class="ed-label">( Our Service )</p>
      <h2 class="ed-title js-shuffle" data-shuffle="view">Service</h2>
    </header>

    <ul class="service__list">
      {
        SERVICES.map((item) => (
          <li class="service__item">
            <div class="service__media">
              <Image
                class="service__image image"
                src={item.image}
                alt={item.title}
              />
            </div>
            <div class="service__copy">
              <p class="service__tag">{item.tag}</p>
              <h3 class="service__title">{item.title}</h3>
              <p class="service__text">{item.description}</p>
              <a class="ed-button" href={`/recruit#${item.id}`}>RECRUIT</a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  .service {
    border-top: 1px solid $c-line;

    &__list {
      display: grid;
      gap: 72px;

      @include tab {
        gap: 104px;
      }
    }

    &__item {
      display: grid;
      gap: 32px;
      min-width: 0;

      @include tab {
        grid-template-columns: 7fr 5fr;
        gap: 48px 80px;
        align-items: center;
      }

      &:nth-child(even) {
        @include tab {
          grid-template-columns: 5fr 7fr;

          .service__media {
            order: 2;
          }
        }
      }

      &:hover :global(.service__image) {
        transform: scale(1.03);
      }
    }

    &__media {
      overflow: hidden;
      aspect-ratio: 4/3;
    }

    &__copy {
      @include tab {
        padding-top: 32px;
      }
    }

    &__tag {
      margin-bottom: 12px;
      font-size: 0.72rem;
      font-weight: 400;
      letter-spacing: 0.42em;
      text-transform: uppercase;
      color: $c-muted;
    }

    &__title {
      margin-bottom: 20px;
      font-size: clamp(1.3rem, 2.2vw, 1.75rem);
      font-weight: 500;
      letter-spacing: 0.12em;
      line-height: 1.5;
    }

    &__text {
      max-width: 26em;
      margin-bottom: 28px;
      font-size: 0.9rem;
      line-height: 2.1;
      color: rgba($c-base, 0.78);
    }
  }

  :global(.service__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: none;
    transition: transform 1s ease;
  }
</style>
