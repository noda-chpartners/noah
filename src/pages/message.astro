---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutNav from "../components/AboutNav.astro";
import EdHead from "../components/EdHead.astro";
import { PAGE_SEO, MESSAGE } from "../data/content";
import { COMPANY_INFO } from "../constants/site";
---

<BaseLayout title={PAGE_SEO.message.title} description={PAGE_SEO.message.description}>
  <section class="section page message">
    <div class="section__inner">
      <EdHead as="h1" label={MESSAGE.label} title={MESSAGE.title} />

      <article class="message__body page-block">
        <div class="message__meta">
          <p class="message__role">{MESSAGE.role}</p>
          <p class="message__name">{COMPANY_INFO.president}</p>
        </div>
        <p class="message__text">{MESSAGE.text}</p>
      </article>

      <AboutNav variant="subnav" />
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .message {
    &__body {
      display: grid;
      gap: 32px;

      @include tab {
        grid-template-columns: 280px 1fr;
        gap: 48px;
        align-items: start;
      }
    }

    &__role {
      margin-bottom: 8px;
      color: $c-muted;
      font-size: 0.78rem;
      letter-spacing: 0.12em;
    }

    &__name {
      font-size: clamp(1.4rem, 2.4vw, 1.9rem);
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1.4;
    }

    &__text {
      max-width: 42em;
      white-space: pre-line;
      font-size: 0.95rem;
      line-height: 2;
    }
  }
</style>
