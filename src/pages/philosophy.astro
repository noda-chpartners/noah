---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutNav from "../components/AboutNav.astro";
import EdHead from "../components/EdHead.astro";
import { PAGE_SEO, PHILOSOPHY } from "../data/content";

const sideItems = [PHILOSOPHY.mission, PHILOSOPHY.value];
---

<BaseLayout title={PAGE_SEO.philosophy.title} description={PAGE_SEO.philosophy.description}>
  <section class="section page philosophy">
    <div class="section__inner">
      <EdHead as="h1" label={PHILOSOPHY.label} title={PHILOSOPHY.title} />

      <p class="philosophy__lead page-block">{PHILOSOPHY.lead}</p>

      <article class="philosophy__vision page-block">
        <p class="philosophy__label js-shuffle" data-shuffle="view">
          {PHILOSOPHY.vision.title}
        </p>
        <h2 class="philosophy__quote">{PHILOSOPHY.vision.subtitle}</h2>
        <p class="philosophy__text">{PHILOSOPHY.vision.text}</p>
      </article>

      <div class="philosophy__pair">
        {
          sideItems.map((item) => (
            <article class="philosophy__block page-block">
              <p class="philosophy__label js-shuffle" data-shuffle="view">
                {item.title}
              </p>
              <h2 class="philosophy__heading">{item.subtitle}</h2>
              <p class="philosophy__text">{item.text}</p>
            </article>
          ))
        }
      </div>

      <AboutNav variant="subnav" />
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .philosophy {
    &__lead {
      max-width: 28em;
      margin-bottom: 48px;
      font-size: clamp(1.2rem, 2vw, 1.6rem);
      font-weight: 300;
      letter-spacing: 0.1em;
      line-height: 1.8;
      white-space: pre-line;

      @include tab {
        margin-bottom: 72px;
      }
    }

    &__vision {
      margin-bottom: 48px;
      padding-bottom: 48px;
      border-bottom: 1px solid $c-line;

      @include tab {
        margin-bottom: 64px;
        padding-bottom: 64px;
      }
    }

    &__label {
      margin-bottom: 16px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.22em;
    }

    &__quote {
      max-width: 18em;
      margin-bottom: 28px;
      font-size: clamp(1.5rem, 3.4vw, 2.5rem);
      font-weight: 700;
      line-height: 1.55;
      letter-spacing: 0.08em;
    }

    &__heading {
      margin-bottom: 16px;
      font-size: clamp(1.05rem, 1.6vw, 1.25rem);
      font-weight: 700;
      line-height: 1.7;
      letter-spacing: 0.06em;
    }

    &__text {
      max-width: 38em;
      color: $c-muted;
      font-size: 0.95rem;
      line-height: 2;
    }

    &__block .philosophy__text {
      font-size: 0.875rem;
      line-height: 1.9;
    }

    &__pair {
      display: grid;
      gap: 36px;

      @include tab {
        grid-template-columns: 1fr 1fr;
        gap: 48px 56px;
      }
    }
  }
</style>
